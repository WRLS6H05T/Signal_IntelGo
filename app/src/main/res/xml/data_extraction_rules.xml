<?xml version="1.0" encoding="utf-8"?>
<!--
  The same selection as backup_rules.xml for Android 12 and later, which reads this file
  instead. Device transfer is included so moving to a new phone keeps the drives.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data/" />
        <exclude domain="file" path="data/tle/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data/" />
    </device-transfer>
</data-extraction-rules>
