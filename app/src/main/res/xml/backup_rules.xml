<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's own backup carries off the phone (API 30 and below).

  Only the data directory: the TLE cache is refetched on first use and the tile cache is
  disposable, so neither belongs in a backup that has a size budget.
-->
<full-backup-content>
    <include domain="file" path="data/" />
    <exclude domain="file" path="data/tle/" />
</full-backup-content>
